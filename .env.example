REF_FILE=data/reference/replica-manhattan_trips.csv
DEMOGRAPGIC_FILE=data/geo/replica-manhattan-demographics.json
CENCUS_FILE=data/geo/replica-manhattan-cencus.geojson
POI_FILE=data/geo/replica-manhattan-poi.csv

# Ollama's default local port; point this at wherever your own Ollama
# instance is serving from.
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=mxbai-embed-large

BASE_URL=http://localhost:11434/v1
API_KEY=ollama
# Built with `ollama create qwen3-nothink:8b -f Modelfile` (see Modelfile in
# this directory).
MODEL=qwen3-nothink:8b

# Free key from https://api.census.gov/data/key_signup.html, used only by
# scripts/build_manhattan_census.py.
CENSUS_API_KEY=your-census-api-key-here
